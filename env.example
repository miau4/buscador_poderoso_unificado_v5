# Token que o @BotFather entrega ao criar o bot (é um segredo, não compartilhe)
TELEGRAM_BOT_TOKEN=cole_o_token_aqui

# IDs numéricos do Telegram de quem pode usar o bot, separados por vírgula.
# Vazio = qualquer pessoa que achar o bot consegue usar (ok só durante o desenvolvimento).
ALLOWED_USER_IDS=

# Arquivo do banco de dados local
DB_PATH=bot.db

# OPCIONAL: provedor de dados de placa (API própria ou contratada, com chave).
# {placa} é trocado pela placa consultada. Sem PLACA_API_URL o bot só mostra a análise e os links oficiais.
# PLACA_API_URL=https://seu-provedor.exemplo/api/placa/{placa}
# PLACA_API_METHOD=GET
# PLACA_API_KEY=sua_chave
# Nome do cabeçalho da chave (padrão Authorization) e prefixo (padrão Bearer; vazio = só a chave).
# PLACA_API_KEY_HEADER=Authorization
# PLACA_API_KEY_PREFIX=Bearer
# Só para POST: corpo JSON e, se precisar, cabeçalhos extras em JSON.
# PLACA_API_BODY={"placa": "{placa}"}
# PLACA_API_HEADERS={"x-outro-cabecalho": "valor"}

# OPCIONAL: chave da API do Have I Been Pwned (haveibeenpwned.com/API/Key, paga).
# Sem ela, os vazamentos vêm do XposedOrNot (gratuito).
# HIBP_API_KEY=
